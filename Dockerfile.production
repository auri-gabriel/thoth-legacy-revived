FROM composer:2 AS php-dependencies

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --no-progress --optimize-autoloader

FROM node:22-bookworm-slim AS frontend

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY assets/scss ./assets/scss
COPY assets/css ./assets/css
RUN npm run build-css

FROM php:8.4-apache

RUN docker-php-ext-install mysqli pdo pdo_mysql \
    && a2enmod rewrite headers expires \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

COPY --from=php-dependencies /app/vendor ./vendor
COPY --from=frontend /app/node_modules ./node_modules
COPY . .
COPY application/config/config_sample.php application/config/config.php
COPY application/config/database_sample.php application/config/database.php
COPY --from=frontend /app/assets/css/theme.css ./assets/css/theme.css

RUN mkdir -p application/cache/sessions application/logs \
    && chown -R www-data:www-data /var/www/html \
    && find application/cache application/logs -type d -exec chmod 775 {} \; \
    && find application/cache application/logs -type f -exec chmod 664 {} \;

ENV CI_ENV=production
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl --fail http://localhost/health.html || exit 1
